#!name = 聚合影视 M3U8 贴片去广告合集
#!desc = 自动清洗 CKZY、午夜、2026系列、THM3U8 等采集站 M3U8 列表开头的 TS/图片切片广告
#!author = 🦋 蝴蝶影视
#!tag = 去广告, 流媒体
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Video.png
#!system = 
#!system_version = 

[Rule]
# --- CKZY ---
DOMAIN-SUFFIX,ckzy3.com,DIRECT
DOMAIN-SUFFIX,ckzyc.vip,DIRECT
DOMAIN-SUFFIX,ptt01.com,DIRECT

# --- 午夜影视 ---
DOMAIN-SUFFIX,cdn-xj.cc,DIRECT
DOMAIN-SUFFIX,cdn-99.cc,DIRECT
DOMAIN-SUFFIX,wuye.mom,DIRECT
DOMAIN-SUFFIX,wuyeys.com,DIRECT
DOMAIN,xn--5us888dtla.wuye.mom,DIRECT
DOMAIN-SUFFIX,lprk.cc,DIRECT
DOMAIN,qweqwe.lprk.cc,DIRECT
DOMAIN-SUFFIX,mtzy2.com,DIRECT

# --- 2026 系列源（森林 / FHV / 大地 等） ---
DOMAIN-SUFFIX,senlin2026.com,DIRECT
DOMAIN-SUFFIX,fhv2026.com,DIRECT
DOMAIN-SUFFIX,dadi2026.com,DIRECT
DOMAIN-SUFFIX,txcy-emo.buzz,DIRECT

# --- 桃花系列源 (THM3U8) ---
DOMAIN-SUFFIX,thm3u8.vip,DIRECT
DOMAIN-SUFFIX,thts4.top,DIRECT

[Script]
# 追加 thm3u8.vip 及其它 th* 格式域名
http-response (?i)^https?:\/\/[^\/]*(ckzy3\.com|cdn-xj\.cc|[a-z0-9]+2026\.com|txcy-emo\.buzz|th[a-z0-9]+\.(vip|top)).*?\.m3u8 script-path = https://raw.githubusercontent.com/GodLike631/Shadow-Rocket/refs/heads/main/Module/clean_m3u8.js, requires-body = true, timeout = 30, tag = 通用M3U8广告清洗

[Mitm]
hostname = *.ckzy3.com, ckzy3.com, *.cdn-xj.cc, *2026.com, *.txcy-emo.buzz, *.thm3u8.vip, thm3u8.vip
